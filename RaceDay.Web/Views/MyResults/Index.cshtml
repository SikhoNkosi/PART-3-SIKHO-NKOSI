@model List<MyResultDto>
@{
    ViewData["Title"] = "My Results";
}

<h2 class="mb-3">My results</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You don't have any results yet. Your results appear here once an organiser has captured them after the event.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <a class="fw-semibold text-decoration-none" asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId">@r.EventName</a>
                            </td>
                            <td>@r.EventDate.ToString("d MMM yyyy")</td>
                            <td>@r.CategoryName</td>
                            <td>@DisplayHelpers.Time(r.FinishTime)</td>
                            <td>
                                @if (r.Position.HasValue)
                                {
                                    <span class="fw-semibold">@DisplayHelpers.Ordinal(r.Position.Value)</span>
                                    @if (r.TotalFinishers > 0)
                                    {
                                        <span class="text-muted"> out of @r.TotalFinishers finishers</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}