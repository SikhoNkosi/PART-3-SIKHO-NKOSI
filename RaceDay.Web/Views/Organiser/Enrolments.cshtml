@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
}

<div class="mb-3">
    <a asp-action="Dashboard" class="text-decoration-none">&larr; Back to dashboard</a>
</div>

<h2 class="mb-1">Enrolments</h2>
<p class="text-muted">@Model.EventName, @Model.EventDate.ToString("d MMM yyyy, HH:mm")</p>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-outline-dark btn-sm" asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@Model.EventId">Manage categories</a>
    <a class="btn btn-warning btn-sm" asp-action="Results" asp-route-eventId="@Model.EventId">Enter results</a>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="alert alert-info">Nobody has enrolled for this event yet.</div>
}
else
{
    <p><strong>@Model.Enrolments.Count</strong> participant(s) enrolled.</p>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Enrolled on</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Enrolments)
                    {
                        <tr>
                            <td>@row.ParticipantName</td>
                            <td>@row.CategoryName</td>
                            <td><partial name="_StatusBadge" model="row.Status" /></td>
                            <td>@row.EnrolmentDate.ToString("d MMM yyyy")</td>
                            <td>
                                @if (row.ResultId.HasValue)
                                {
                                    <span>@row.FinishTime?.ToString(@"h\:mm\:ss") (position @row.Position)</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not captured yet</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}