@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Organiser dashboard</h2>
    <a class="btn btn-warning" asp-controller="ManageEvents" asp-action="Create">+ Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">Events created</div>
                <div class="display-6 fw-bold">@Model.Events.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">Upcoming events</div>
                <div class="display-6 fw-bold">@Model.Events.Count(e => e.EventDate >= DateTime.Now)</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">Total enrolments</div>
                <div class="display-6 fw-bold">@Model.TotalEnrolments</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="mb-3">Coming up</h5>
                @if (Model.UpcomingEvents.Count == 0)
                {
                    <p class="text-muted mb-0">No upcoming events. Create one to get started.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Model.UpcomingEvents)
                        {
                            <li class="list-group-item px-0">
                                <div class="fw-semibold">@e.EventName</div>
                                <div class="text-muted small">@e.EventDate.ToString("ddd d MMM yyyy, HH:mm")</div>
                                <div class="small">@e.TotalEnrolments enrolled</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="mb-3">All my events</h5>
                @if (Model.Events.Count == 0)
                {
                    <p class="text-muted mb-0">You haven't created any events yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Event</th>
                                    <th>Date</th>
                                    <th class="text-center">Categories</th>
                                    <th class="text-center">Enrolments</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.Events)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@e.EventName</div>
                                            <span class="badge bg-secondary">@e.EventType</span>
                                        </td>
                                        <td>@e.EventDate.ToString("d MMM yyyy")</td>
                                        <td class="text-center">@e.CategoryCount</td>
                                        <td class="text-center">@e.TotalEnrolments</td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-dark" asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@e.EventId">Categories</a>
                                            <a class="btn btn-sm btn-outline-dark" asp-action="Enrolments" asp-route-eventId="@e.EventId">Enrolments</a>
                                            <a class="btn btn-sm btn-warning" asp-action="Results" asp-route-eventId="@e.EventId">Results</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>