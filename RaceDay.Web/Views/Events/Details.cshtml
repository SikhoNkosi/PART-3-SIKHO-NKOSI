@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.EventName;
    var isPast = ev.EventDate < DateTime.Now;
    var isParticipant = Model.IsLoggedIn && Model.Role == "Participant";
    var returnUrl = Url.Action("Details", "Events", new { id = ev.EventId });
}

<div class="mb-3">
    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">&larr; Back to all events</a>
</div>

<div class="card shadow-sm mb-4">
    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
    {
        <img src="@ev.BannerImageUrl" class="card-img-top" alt="Banner for @ev.EventName"
             style="max-height:320px;object-fit:cover;" />
    }
    else
    {
        <div class="bg-dark text-warning d-flex align-items-center justify-content-center fw-bold"
             style="height:200px;font-size:3rem;letter-spacing:3px;">RACEDAY</div>
    }

    <div class="card-body p-4">
        <h1 class="h2">@ev.EventName</h1>
        <div class="mb-3">
            <span class="badge bg-secondary">@ev.EventType</span>
            <span class="badge bg-light text-dark border">@ev.Distance km</span>
            @if (isPast)
            {
                <span class="badge bg-dark">Finished</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ev.Description))
        {
            <p>@ev.Description</p>
        }

        <dl class="row mb-0">
            <dt class="col-sm-3">Date and time</dt>
            <dd class="col-sm-9">@ev.EventDate.ToString("dddd d MMMM yyyy, HH:mm")</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(ev.Province) ? ev.Location : ev.Location + ", " + ev.Province)</dd>

            @if (!string.IsNullOrWhiteSpace(ev.RouteMapUrl))
            {
                <dt class="col-sm-3">Route</dt>
                <dd class="col-sm-9"><a href="@ev.RouteMapUrl" target="_blank" rel="noopener">View the route map</a></dd>
            }
        </dl>
    </div>
</div>

<h3 class="mb-3">Categories</h3>

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-info">The organiser hasn't added any categories yet. Please check back soon.</div>
}
else
{
    @if (!Model.IsLoggedIn && !isPast)
    {
        <div class="alert alert-warning">
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">Log in</a>
            or <a asp-controller="Account" asp-action="Register">create an account</a> to enter this event.
        </div>
    }
    else if (Model.IsLoggedIn && !isParticipant)
    {
        <div class="alert alert-secondary">Organiser accounts can't enter events. Use a Participant account to enter.</div>
    }

    <div class="row g-3 mb-4">
        @foreach (var c in Model.Categories)
        {
            var alreadyEntered = Model.EnrolledCategoryIds.Contains(c.CategoryId);

            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@c.CategoryName</h5>
                        <ul class="list-unstyled mb-0">
                            @if (c.DistanceKm.HasValue)
                            {
                                <li>Distance: @c.DistanceKm.Value km</li>
                            }
                            <li>Entry fee: R @c.EntryFee.ToString("0.00")</li>
                            <li>Places: @c.MaxParticipants</li>
                        </ul>
                    </div>

                    @if (isParticipant)
                    {
                        <div class="card-footer bg-white">
                            @if (alreadyEntered)
                            {
                                <span class="badge bg-success">You are entered</span>
                            }
                            else if (isPast)
                            {
                                <span class="text-muted">Entries are closed</span>
                            }
                            else
                            {
                                <form asp-controller="Events" asp-action="Enrol" method="post">
                                    <input type="hidden" name="eventId" value="@ev.EventId" />
                                    <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                    <button type="submit" class="btn btn-warning w-100">Enter this category</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (Model.Results.Count > 0)
{
    <h3 class="mb-3">Results</h3>
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Position</th>
                        <th>Participant</th>
                        <th>Finish time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Results.OrderBy(x => x.CategoryName).ThenBy(x => x.Position ?? int.MaxValue))
                    {
                        <tr>
                            <td>@r.CategoryName</td>
                            <td>@(r.Position.HasValue ? DisplayHelpers.Ordinal(r.Position.Value) : "-")</td>
                            <td>@r.ParticipantName</td>
                            <td>@DisplayHelpers.Time(r.FinishTime)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}