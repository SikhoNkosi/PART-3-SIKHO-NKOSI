@model EventFormViewModel
@{
    var isEdit = Model.EventId != 0;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
    var provinces = new[] { "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal", "Limpopo", "Mpumalanga", "Northern Cape", "North West", "Western Cape" };
    var eventTypes = new[] { "Run", "Walk", "Cycle" };
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">@(isEdit ? "Edit event" : "Create a new event")</h2>

                <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.EventId : (int?)null)"
                      method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="EventId" />

                    <div class="mb-3">
                        <label asp-for="EventName" class="form-label"></label>
                        <input asp-for="EventName" class="form-control" />
                        <span asp-validation-for="EventName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input type="datetime-local" id="EventDate" name="EventDate" class="form-control"
                                   value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select" asp-items="@(new SelectList(eventTypes, Model.EventType))"></select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Sea Point Promenade, Cape Town" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Province" class="form-label"></label>
                            <select asp-for="Province" class="form-select" asp-items="@(new SelectList(provinces, Model.Province))">
                                <option value="">Choose a province</option>
                            </select>
                            <span asp-validation-for="Province" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RouteMapUrl" class="form-label"></label>
                        <input asp-for="RouteMapUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="RouteMapUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Banner" class="form-label"></label>
                        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.BannerImageUrl" alt="Current banner" class="img-thumbnail" style="max-height:140px;" />
                                <div class="form-text">Current banner. Choose a new image below to replace it.</div>
                            </div>
                        }
                        <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" />
                        <div class="form-text">JPG, PNG or WEBP, up to 5 MB.</div>
                    </div>

                    <button type="submit" class="btn btn-warning">@(isEdit ? "Save changes" : "Create event")</button>
                    <a class="btn btn-outline-secondary ms-2" asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}