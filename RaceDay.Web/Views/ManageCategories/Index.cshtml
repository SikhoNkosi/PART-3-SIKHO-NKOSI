@model CategoriesPageViewModel
@{
    ViewData["Title"] = "Categories";
}

<div class="mb-3">
    <a asp-controller="ManageEvents" asp-action="Index" class="text-decoration-none">&larr; Back to my events</a>
</div>

<h2 class="mb-1">Categories</h2>
<p class="text-muted">@Model.EventName</p>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="mb-3">Categories for this event</h5>

                @if (Model.Categories.Count == 0)
                {
                    <p class="text-muted mb-0">No categories yet. Add one with the form so participants can enter.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Distance</th>
                                    <th>Fee</th>
                                    <th>Places</th>
                                    <th>Enrolled</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Categories)
                                {
                                    var enrolled = Model.EnrolmentCounts.TryGetValue(c.CategoryId, out var count) ? count : 0;

                                    <tr>
                                        <td class="fw-semibold">@c.CategoryName</td>
                                        <td>@(c.DistanceKm.HasValue ? c.DistanceKm.Value + " km" : "-")</td>
                                        <td>R @c.EntryFee.ToString("0.00")</td>
                                        <td>@c.MaxParticipants</td>
                                        <td>@enrolled</td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-dark" asp-action="Edit"
                                               asp-route-eventId="@Model.EventId" asp-route-categoryId="@c.CategoryId">Edit</a>

                                            <form asp-action="Delete" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this category?');">
                                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                                <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        disabled="@(enrolled > 0)"
                                                        title="@(enrolled > 0 ? "Categories with enrolments can't be deleted" : "Delete this category")">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="mb-3">Add a category</h5>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <input type="hidden" asp-for="NewCategory.EventId" />

                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                        <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="e.g. 10km Run or Under 20" />
                        <span asp-validation-for="NewCategory.CategoryName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                        <input asp-for="NewCategory.DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="NewCategory.DistanceKm" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.EntryFee" class="form-label"></label>
                        <input asp-for="NewCategory.EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.EntryFee" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.MaxParticipants" class="form-label"></label>
                        <input asp-for="NewCategory.MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="NewCategory.MaxParticipants" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-warning w-100">Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}