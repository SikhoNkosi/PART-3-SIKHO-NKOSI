@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Edit category</h2>

                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="CategoryId" />

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label"></label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EntryFee" class="form-label"></label>
                        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="EntryFee" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-warning">Save changes</button>
                    <a class="btn btn-outline-secondary ms-2" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}